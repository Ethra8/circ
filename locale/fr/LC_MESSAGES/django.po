msgstr "Échec de connexion via un réseau social"

#: .\templates\allauth\socialaccount\authentication_error.html:10
msgid ""
"An error occurred while attempting to login via your social network account."
msgstr ""
"Une erreur s’est produite lors de la tentative de connexion via votre compte "
"de réseau social."

#: .\templates\allauth\socialaccount\connections.html:5
#: .\templates\allauth\socialaccount\connections.html:8
msgid "Account Connections"
msgstr "Comptes associés"

#: .\templates\allauth\socialaccount\connections.html:11
msgid ""
"You can sign in to your account using any of the following third party "
"accounts:"
msgstr ""
"Vous pouvez vous connecter à votre compte en utilisant l’un des comptes "
"tiers suivants :"

#: .\templates\allauth\socialaccount\connections.html:43
msgid ""
"You currently have no social network accounts connected to this account."
msgstr "Aucun compte de réseau social n’est actuellement associé à ce compte."

#: .\templates\allauth\socialaccount\connections.html:46
msgid "Add a 3rd Party Account"
msgstr "Ajouter un compte tiers"

#: .\templates\allauth\socialaccount\login.html:8
#, python-format
msgid "Connect %(provider)s"
msgstr "Connecter %(provider)s"

#: .\templates\allauth\socialaccount\login.html:10
#, python-format
msgid "You are about to connect a new third party account from %(provider)s."
msgstr ""
"Vous êtes sur le point d’associer un nouveau compte tiers provenant de "
"%(provider)s."

#: .\templates\allauth\socialaccount\login.html:12
#, python-format
msgid "Sign In Via %(provider)s"
msgstr "Se connecter via %(provider)s"

#: .\templates\allauth\socialaccount\login.html:14
#, python-format
msgid "You are about to sign in using a third party account from %(provider)s."
msgstr ""
"Vous êtes sur le point de vous connecter à l’aide d’un compte tiers "
"provenant de %(provider)s."

#: .\templates\allauth\socialaccount\login.html:19
msgid "Continue"
msgstr "Continuer"

#: .\templates\allauth\socialaccount\login_cancelled.html:5
#: .\templates\allauth\socialaccount\login_cancelled.html:9
msgid "Login Cancelled"
msgstr "Connexion annulée"

#: .\templates\allauth\socialaccount\login_cancelled.html:13
#, python-format
msgid ""
"You decided to cancel logging in to our site using one of your existing "
"accounts. If this was a mistake, please proceed to <a "
"href=\"%(login_url)s\">sign in</a>."
msgstr ""
"Vous avez choisi d’annuler la connexion à notre site à l’aide de l’un de vos "
"comptes existants. S’il s’agit d’une erreur, veuillez <a "
"href=\"%(login_url)s\">vous connecter</a>."

#: .\templates\allauth\socialaccount\messages\account_connected.txt:2
msgid "The social account has been connected."
msgstr "Le compte social a été associé."

#: .\templates\allauth\socialaccount\messages\account_connected_other.txt:2
msgid "The social account is already connected to a different account."
msgstr "Le compte social est déjà associé à un autre compte."

#: .\templates\allauth\socialaccount\messages\account_disconnected.txt:2
msgid "The social account has been disconnected."
msgstr "Le compte social a été dissocié."

#: .\templates\allauth\socialaccount\signup.html:10
#, python-format
msgid ""
"You are about to use your %(provider_name)s account to login to\n"
"%(site_name)s. As a final step, please complete the following form:"
msgstr ""
"Vous êtes sur le point d’utiliser votre compte %(provider_name)s pour vous "
"connecter à\n"
"%(site_name)s. Pour terminer, veuillez remplir le formulaire suivant :"

