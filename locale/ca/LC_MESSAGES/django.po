#: .\templates\allauth\account\password_change.html:13
#: .\templates\allauth\account\password_reset_from_key.html:5
#: .\templates\allauth\account\password_reset_from_key_done.html:4
msgid "Change Password"
msgstr "Canviar la contrasenya"

#: .\templates\allauth\account\password_reset.html:7
#: .\templates\allauth\account\password_reset_done.html:6
msgid "Password Reset"
msgstr "Restablir la contrasenya"

#: .\templates\allauth\account\password_reset.html:15
msgid ""
"Forgotten your password? Enter your e-mail address below, and we'll send you "
"an e-mail allowing you to reset it."
msgstr ""
"Has oblidat la contrasenya? Introdueix la teva adreça de correu electrònic a "
"continuació i t’enviarem un correu perquè la puguis restablir."

#: .\templates\allauth\account\password_reset.html:20
msgid "Reset My Password"
msgstr "Restablir la meva contrasenya"

#: .\templates\allauth\account\password_reset.html:23
msgid "Please contact us if you have any trouble resetting your password."
msgstr ""
"Contacta amb nosaltres si tens cap problema per restablir la contrasenya."

#: .\templates\allauth\account\password_reset_done.html:14
msgid ""
"We have sent you an e-mail. If you have not received it please check your "
"spam folder. Otherwise contact us if you do not receive it in a few minutes."
msgstr ""
"T’hem enviat un correu electrònic. Si no l’has rebut, comprova la carpeta de "
"correu brossa. Si no el reps al cap d’uns minuts, contacta amb nosaltres."

#: .\templates\allauth\account\password_reset_from_key.html:11
#, python-format
msgid ""
"The password reset link was invalid, possibly because it has already been "
"used.  Please request a <a href=\"%(passwd_reset_url)s\">new password reset</"
"a>."
msgstr ""
"L’enllaç per restablir la contrasenya no és vàlid, possiblement perquè ja "
"s’ha utilitzat. Sol·licita un <a href=\"%(passwd_reset_url)s\">nou "
"restabliment de contrasenya</a>."

#: .\templates\allauth\account\password_reset_from_key.html:16
msgid "change password"
msgstr "canviar la contrasenya"

#: .\templates\allauth\account\password_reset_from_key_done.html:8
msgid "Your password is now changed."
msgstr "La teva contrasenya s’ha canviat correctament."

#: .\templates\allauth\account\password_set.html:6
#: .\templates\allauth\account\password_set.html:13
msgid "Set Password"
msgstr "Establir contrasenya"

#: .\templates\allauth\account\signup.html:6
#: .\templates\allauth\socialaccount\signup.html:5
msgid "Signup"
msgstr "Registre"

#: .\templates\allauth\account\signup.html:10
#, python-format
msgid ""
"Already have an account? Then please <a href=\"%(login_url)s\">sign in</a>."
msgstr "Ja tens un compte? Doncs <a href=\"%(login_url)s\">inicia sessió</a>."

#: .\templates\allauth\account\signup.html:18 .\templates\allauth\base.html:35
#: .\templates\allauth\socialaccount\signup.html:8
#: .\templates\allauth\socialaccount\signup.html:19
msgid "Sign Up"
msgstr "Registrar-se"

#: .\templates\allauth\account\signup_closed.html:5
msgid "Sign Up Closed"
msgstr "Registre tancat"

#: .\templates\allauth\account\signup_closed.html:9
msgid "We are sorry, but the sign up is currently closed."
msgstr "Ho sentim, però actualment el registre està tancat."

#: .\templates\allauth\account\snippets\already_logged_in.html:5
msgid "Note"
msgstr "Nota"

#: .\templates\allauth\account\snippets\already_logged_in.html:5
#, python-format
msgid "you are already logged in as %(user_display)s."
msgstr "ja has iniciat sessió com a %(user_display)s."

#: .\templates\allauth\account\verification_sent.html:5
#: .\templates\allauth\account\verified_email_required.html:5
msgid "Verify Your E-mail Address"
msgstr "Verifica la teva adreça de correu electrònic"

#: .\templates\allauth\account\verification_sent.html:9
msgid ""
"We have sent an e-mail to you for verification. Follow the link provided to "
"finalize the signup process. If you do not see the verification e-mail in "
"your main inbox, check your spam folder. Please contact us if you do not "
"receive the verification e-mail within a few minutes."
msgstr ""
"T’hem enviat un correu electrònic de verificació. Segueix l’enllaç inclòs en "
"el missatge per completar el procés de registre. Si no veus el correu de "
"verificació a la safata d’entrada, comprova la carpeta de correu brossa. "
"Contacta amb nosaltres si no el reps al cap d’uns minuts."

#: .\templates\allauth\account\verified_email_required.html:11
msgid ""
"This part of the site requires us to verify that\n"
"you are who you claim to be. For this purpose, we require that you\n"
"verify ownership of your e-mail address. "
msgstr ""
"Aquesta part del lloc web requereix que verifiquem que\n"
"ets qui dius ser. Per aquest motiu, necessitem que\n"
"verifiquis que ets titular de la teva adreça de correu electrònic. "

#: .\templates\allauth\account\verified_email_required.html:15
msgid ""
"We have sent an e-mail to you for\n"
"verification. Please click on the link inside that e-mail. If you do not see "
"the verification e-mail in your main inbox, check your spam folder. "
"Otherwise\n"
"contact us if you do not receive it within a few minutes."
msgstr ""
"T’hem enviat un correu electrònic de\n"
"verificació. Fes clic a l’enllaç inclòs al correu. Si no veus el correu de "
"verificació a la safata d’entrada, comprova la carpeta de correu brossa. Si "
"tot i així\n"
"no el reps al cap d’uns minuts, contacta amb nosaltres."

#: .\templates\allauth\account\verified_email_required.html:19
#, python-format
msgid ""
"<strong>Note:</strong> you can still <a href=\"%(email_url)s\">change your e-"
"mail address</a>."
msgstr ""
"<strong>Nota:</strong> encara pots <a href=\"%(email_url)s\">canviar la teva "
"adreça de correu electrònic</a>."

