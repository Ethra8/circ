msgstr ""
"Pots iniciar sessió al teu compte utilitzant qualsevol dels comptes externs "
"següents:"

#: .\templates\allauth\socialaccount\connections.html:43
msgid ""
"You currently have no social network accounts connected to this account."
msgstr ""
"Actualment no tens cap compte de xarxa social vinculat a aquest compte."

